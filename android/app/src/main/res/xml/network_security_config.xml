<?xml version="1.0" encoding="utf-8"?>
<!-- No plain HTTP, except to Tailscale (MagicDNS) names: NanoKVMs only speak HTTP, and PowerDeck reaches
     them only over Tailscale, where WireGuard encrypts the traffic. The helper API is HTTPS, pinned to
     each device's certificate. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ts.net</domain>
    </domain-config>
</network-security-config>
